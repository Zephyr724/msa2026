{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": []
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Auth": {
    "RateLimits": {
      "RegisterPermitLimit": 5,
      "LoginPermitLimit": 10,
      "WindowMinutes": 15
    }
  },
  "Seed": {
    "Roles": true,
    "Region": false,
    "DemoQuests": false,
    "DemoAccounts": false
  }
}
