{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": []
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "DataProtection": {
    "ApplicationName": "Kiwimpact",
    "KeyPath": ""
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "Hosting": {
    "Railway": {
      "Enabled": false
    }
  },
  "Auth": {
    "RequireConfirmedEmail": true,
    "FrontendBaseUrl": "http://localhost:5173",
    "RateLimits": {
      "RegisterPermitLimit": 5,
      "LoginPermitLimit": 10,
      "WindowMinutes": 15
    }
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Email": {
    "Enabled": false,
    "From": "noreply@kiwimpact.local",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025
    }
  },
  "EvidencePurge": {
    "Enabled": true,
    "InitialDelay": "00:02:00",
    "Interval": "12:00:00"
  },
  "CommunityChallenges": {
    "FinalizerEnabled": true,
    "FinalizerInterval": "00:15:00"
  },
  "Social": {
    "RateLimits": {
      "PublishPermitLimit": 6,
      "CommentPermitLimit": 30,
      "ReactionPermitLimit": 120,
      "WindowMinutes": 1
    }
  },
  "Seed": {
    "Roles": true,
    "Region": false,
    "DemoQuests": false,
    "DemoAccounts": false
  }
}
