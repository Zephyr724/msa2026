# Copy to .env and replace every REPLACE value before using Compose.
# Generate independent values; never reuse a production credential.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
COMPLETION_CODES_HMAC_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

APP_PORT=8080
POSTGRES_PORT=5433
KIWIMPACT_IMAGE_TAG=local
ALLOWED_HOSTS=localhost;127.0.0.1

# Optional browser-visible Google Maps configuration. Restrict the key by API
# and website referrer. These values are embedded into the built frontend.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Set true only when starting the optional Mailpit development profile.
EMAIL_ENABLED=false
