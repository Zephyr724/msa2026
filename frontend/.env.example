# Vite dev proxy target — the backend URL the dev server proxies to.
# Default: http://localhost:5000
VITE_DEV_PROXY_TARGET=http://localhost:5000

# Browser API base URL used by apiFetch for backend requests.
# Default: /api (relative, works with the Vite dev proxy)
VITE_API_BASE_URL=/api

# Dedicated browser key restricted to the Maps JavaScript API and the exact
# localhost/production website referrers. This value is intentionally visible
# to browsers and must be protected with Google Cloud restrictions.
VITE_GOOGLE_MAPS_API_KEY=

# JavaScript map ID from Google Maps Platform Map Management. A real map ID is
# required for the Advanced Markers used by Quest discovery and coordinate picking.
VITE_GOOGLE_MAPS_MAP_ID=
